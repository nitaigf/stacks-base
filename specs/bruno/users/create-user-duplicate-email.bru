meta {
  name: Create User Duplicate Email
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "name": "Duplicate User",
    "email": "{{registeredEmail}}",
    "password": "{{testPassword}}",
    "role": "member",
    "status": "active"
  }
}

assert {
  res.status: eq 409
  res.body.error.code: eq email_taken
}
