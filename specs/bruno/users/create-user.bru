meta {
  name: Create User
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/users
  body: json
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "name": "Bruno Admin Created",
    "email": "bruno-admin-created-{{$timestamp}}@test.local",
    "password": "{{testPassword}}",
    "role": "member",
    "status": "active"
  }
}

assert {
  res.status: eq 201
  res.body.data.email: isString
  res.body.data.role: eq member
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("createdUserId", res.body.data.id);
  }
}
