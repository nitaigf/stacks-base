meta {
  name: Admin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.data.user.role: eq admin
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("adminAccessToken", res.body.data.accessToken);
  }
}
