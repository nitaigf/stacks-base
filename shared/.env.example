APP_ENV=development
APP_NAME=stacks-base

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=stacks_base
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSLMODE=disable

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
BACKEND_ALLOWED_ORIGIN=http://127.0.0.1:3000
FRONTEND_BASE_URL=http://127.0.0.1:3000

FRONTEND_PORT=3000
VITE_API_BASE_URL=http://127.0.0.1:8080

ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-me-with-a-second-long-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me

ADMIN_SEED_ENABLED=true
ADMIN_INITIAL_NAME=Admin
ADMIN_INITIAL_EMAIL=admin@stacks-base.local
ADMIN_INITIAL_PASSWORD=Admin@123456
SMTP_FROM_NAME=Stacks Base
SMTP_FROM_ADDRESS=no-reply@stacks-base.local