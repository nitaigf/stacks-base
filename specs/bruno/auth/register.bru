meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
}

body:json {
  {
    "name": "{{testName}}",
    "email": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

assert {
  res.status: eq 201
  res.body.data.accessToken: isString
  res.body.data.user.name: eq {{testName}}
  res.body.data.user.role: eq member
  res.body.data.user.status: eq active
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("accessToken", res.body.data.accessToken);
    bru.setVar("registeredEmail", req.body.email);
  }
}
