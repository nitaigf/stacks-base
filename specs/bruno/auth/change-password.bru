meta {
  name: Change Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/change-password
  body: json
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "currentPassword": "{{testPassword}}",
    "newPassword": "password456"
  }
}

assert {
  res.status: eq 200
  res.body.data.message: isString
}
