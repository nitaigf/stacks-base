meta {
  name: Me
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/users/me
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.data.id: isString
  res.body.data.name: isString
  res.body.data.email: isString
  res.body.data.role: in member,admin
  res.body.data.status: eq active
}
